# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）。
# 所有变量都有默认值，不建 .env 也能直接 docker compose up。

# 浏览器访问前端的端口
FRONTEND_PORT=8088
# 后端暴露给宿主机（以及 Unity 客户端）的端口
BACKEND_PORT=8080
# 镜像标签
TAG=latest

# 基础镜像前缀。默认走镜像加速站；直连 Docker Hub 时把它留空（BASE_REGISTRY=）
BASE_REGISTRY=docker.m.daocloud.io/library/
# 构建期依赖下载源，内网或海外可改成官方源
GOPROXY=https://goproxy.cn,direct
NPM_REGISTRY=https://registry.npmmirror.com
